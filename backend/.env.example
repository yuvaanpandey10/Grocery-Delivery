PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/grocery_delivery
JWT_SECRET=replace-with-a-unique-secret-at-least-32-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

STRIPE_MODE=test
STRIPE_SECRET_KEY=
# Set this from the Stripe webhook endpoint /api/order/stripe/webhook.
STRIPE_WEBHOOK_SECRET=
